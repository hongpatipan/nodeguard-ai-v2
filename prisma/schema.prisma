// Prisma schema — History Log & Audit Trail
// ใช้ Postgres (แนะนำ Vercel Postgres/Neon เพราะ deploy บน Vercel อยู่แล้ว ตั้งค่าได้จากหน้า Storage
// ของ Vercel project โดยตรง ไม่ต้องสมัครบริการภายนอกเพิ่ม) — ตั้งค่า DATABASE_URL ใน .env.local
// (dev) และ Vercel Environment Variables (production) ดูขั้นตอนเต็มใน README.md

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: ห้ามใส่ url ในนี้แล้ว — ย้ายไปตั้งค่าใน prisma.config.ts (CLI) และ lib/prisma.ts
// (runtime, ผ่าน driver adapter @prisma/adapter-pg) แทน — ดู pris.ly/d/prisma7-client-config
datasource db {
  provider = "postgresql"
}

enum LogSeverity {
  critical
  warning
  optimization
  passed // ไม่พบปัญหาเลย (verdict = approve, issues ว่าง)
}

enum LogStatus {
  FLAGGED // พบปัญหา ยังไม่ได้แก้
  RESOLVED // แก้ไขแล้ว (หรือไม่พบปัญหาตั้งแต่แรก — เริ่มเป็น RESOLVED เลย)
  FAILED // Gemini error/timeout ระหว่างวิเคราะห์ — ไม่มีผลตรวจให้ดู
}

model ReviewLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ที่มาของโค้ดที่ตรวจ
  sourceKind  String // "github" | "gitlab" | "paste"
  sourceLabel String // เช่น "owner/repo#123" หรือ "วางโค้ดเอง"
  // "owner/repo" (github) หรือ "group/project" (gitlab) — ตัดเลข PR/MR ออก ใช้จับคู่ auto-resolve
  // ข้าม PR คนละใบได้ (null สำหรับ paste เพราะไม่มี repo ให้จับคู่จริง)
  repoKey String?
  // commit SHA ของโค้ดที่ตรวจตอนนั้น (PR/MR เท่านั้น, null สำหรับ paste) — ใช้กันซ้ำตอนกดสแกนรัว ๆ
  // บน PR เดิมที่โค้ดยังไม่เปลี่ยนเลย (แม่นยำกว่าเทียบว่า "ปัญหาหน้าตาเหมือนกันไหม" เพราะ SHA
  // บอกตรง ๆ ว่าโค้ดชุดเดียวกันเป๊ะหรือเปล่า ไม่มีทางกำกวม)
  commitSha String?
  // จำนวนครั้งที่สแกน "โค้ดชุดเดียวกันเป๊ะ" (repo+PR+commit+model ตรงกันหมด) ซ้ำ — แทนที่จะสร้าง
  // แถวใหม่ทุกครั้งที่กดซ้ำเฉย ๆ โดยโค้ดไม่เปลี่ยน ก็แค่นับเพิ่มในแถวเดิม ไม่เสีย audit trail
  scanCount Int @default(1)

  // โมเดล/วิธีที่ใช้ตรวจ
  model String // เช่น "gemini-3.8-flash" หรือ "quick-scan"

  issuesFoundCount Int
  severity         LogSeverity
  status           LogStatus @default(FLAGGED)

  // รายชื่อไฟล์ทั้งหมดที่ถูกสแกนรอบนี้ (ไม่ใช่แค่ไฟล์ที่เจอปัญหา) — ใช้เช็คว่า "ไฟล์นี้เคยถูก
  // ตรวจซ้ำแล้วจริง" ตอน auto-resolve, และ flaggedFiles คือ subset ของไฟล์ที่เจอปัญหาจริง
  // (ว่างถ้า RESOLVED/passed) ใช้เทียบว่า log เก่าควรเปลี่ยนเป็น RESOLVED ไหม
  filesReviewed String[]
  flaggedFiles  String[]

  // เก็บผลตรวจเต็ม (summary, verdict, issues[]) เป็น JSON — ไม่มี API key/token ปนอยู่แน่นอน
  // เพราะ ReviewResponse ที่ส่งมาจาก Gemini ไม่เคยมีข้อมูลพวกนี้ตั้งแต่ต้น
  fullReviewOutput Json

  // ข้อความ error (เฉพาะตอน status = FAILED)
  errorMessage String?

  @@index([createdAt])
  @@index([status])
  @@index([repoKey, status])
  @@index([repoKey, commitSha, model])
}
