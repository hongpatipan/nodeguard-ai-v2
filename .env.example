# ---- Google Gemini (optional — key กลางของ server) ----
# ขอฟรีได้ที่ https://aistudio.google.com/apikey
# เว็บนี้ให้แต่ละคนในทีมกรอก Gemini API Key ของตัวเองในหน้าเว็บได้ (เก็บใน localStorage ของ
# browser ตัวเอง ไม่ส่งขึ้นมาเก็บที่ server) — ตัวแปรนี้เป็นแค่ "key สำรอง" เผื่อใครไม่ได้ตั้งเอง
# ถ้าอยากบังคับให้ทุกคนต้องใส่ key ของตัวเอง ให้ปล่อยว่างไว้
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# โมเดลเริ่มต้น (ผู้ใช้สลับได้จาก dropdown ในหน้าเว็บ ค่านี้ใช้เป็นค่าเริ่มต้นเท่านั้น)
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# ---- GitHub (optional) ----
# ใส่เมื่อจะดึง diff จาก private repo หรือต้องการ rate limit สูงขึ้น (60 -> 5000 req/hr)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- GitLab (optional) ----
# ใส่เมื่อจะดึง diff จาก private project — ต้องมีสิทธิ์อย่างน้อย read_api
# ใช้ได้ทั้ง gitlab.com และ self-hosted GitLab (host มาจาก URL ที่ใส่ในหน้าเว็บโดยตรง)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ---- Token budget (optional) ----
# จำนวนตัวอักษรสูงสุดของ diff ที่ยอมส่งให้ AI (กันโดน rate limit / โควตาหมดไวเกินไป)
MAX_DIFF_CHARS=60000
